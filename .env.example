# Supabase project → Settings → API. Leave empty to run in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Telegram bot (optional, server only: never add NEXT_PUBLIC_ to these). See README → בוט טלגרם.
TELEGRAM_BOT_TOKEN=
# Any long random string of letters, digits, _ or -.
TELEGRAM_WEBHOOK_SECRET=
# Supabase → Project Settings → API → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
# The bot's username without @, so Settings can open the bot with the code filled in.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
